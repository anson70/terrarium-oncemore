// effect.cmake. Do not edit the generated copy.
#include "registry.h"

@TFX_REGISTRY_INCLUDES@
namespace tfx {

namespace {
struct Entry {
    const char* name;
    std::unique_ptr<Effect> (*create)();
};

const Entry kEffects[] = {
@TFX_REGISTRY_ENTRIES@};
} // namespace

std::unique_ptr<Effect> createEffect(const std::string& name) {
    for (const Entry& e : kEffects)
        if (name == e.name) return e.create();
    return nullptr;
}

std::vector<std::string> effectNames() {
    std::vector<std::string> names;
    for (const Entry& e : kEffects) names.emplace_back(e.name);
    return names;
}

} // namespace tfx
